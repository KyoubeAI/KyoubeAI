# ---- Compose project ----
# Names the containers and volumes (<name>_pgdata, <name>_kyoubeai-home).
# install.sh sets it; keep it when you move the folder.
# COMPOSE_PROJECT_NAME=kyoubeai

# ---- Required secrets (generate each with: openssl rand -hex 32) ----
# The two database passwords must contain only letters and digits: they are embedded in connection URLs.
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
KYOUBE_DB_PASSWORD=

# ---- Reachability ----
# The URL people type into the browser. Must match exactly (scheme, host, port).
KYOUBE_PUBLIC_URL=http://localhost:3100
KYOUBE_PORT=3100
# private = LAN/VPN/Tailscale (browser first-admin claim enabled); public = internet-facing (put TLS in front)
KYOUBE_DEPLOYMENT_EXPOSURE=private
# If KYOUBE_PUBLIC_URL's host is localhost/127.0.0.1 and KYOUBE_PORT is changed
# from 3100 (e.g. to run a second instance side by side), also set this to the
# same http://localhost:<KYOUBE_PORT> — the core otherwise derives the trusted
# origin from its internal port (3100) and rejects sign-up/claim with 403.
BETTER_AUTH_TRUSTED_ORIGINS=
# Behind a reverse proxy or tunnel (Caddy, Traefik, nginx, cloudflared)? The
# core only believes forwarded headers from a proxy it trusts: `uniquelocal`
# trusts one on the same Docker network. Leave empty when people reach the app
# directly.
TRUST_PROXY=

# `auto` (the default) trusts this container as the host that runs agents'
# local tools. A public instance needs that for Claude/Codex subscription
# sign-in from Connections and for local MCP tools. Leave empty to turn it off.
KYOUBE_TRUSTED_RUNTIME_HOST=auto

# Agent working rules (docs/agent-rules.md): agents finish their own tasks, send
# approvals to the person who started the task, and move work up to a manager
# agent only with that person's decision. To remove them: set this to off,
# restart, then run `docker compose exec app kyoube agent-rules off`. User groups
# (docs/groups.md) keep syncing either way.
KYOUBE_AGENT_RULES=on

# ---- Versions ----
# The pinned upstream core image (bumped with scripts/bump-core.sh).
KYOUBE_CORE_VERSION=2026.1012.0
# The KyoubeAI image is KYOUBE_IMAGE:KYOUBE_VERSION. ./install.sh writes both
# and ./update.sh moves them; change them by hand only on an install you run
# without those scripts. For a published release, set the image to
# ghcr.io/jknigel/kyoubeai and the version to the release (for example 1.1.0),
# then `docker compose pull && docker compose up -d`. The version dev with the
# image unset (kyoubeai) or another local name without a '/' is a build from
# docker/Dockerfile (`docker compose up -d --build`); two such installs on one
# machine each need their own image name (docs/operations.md).
KYOUBE_VERSION=dev
# KYOUBE_IMAGE=ghcr.io/jknigel/kyoubeai

# ---- Optional: unattended plugin install (instance-admin board API key) ----
KYOUBE_BOARD_API_KEY=

# ---- Optional: disable the plugin bootstrap watcher ----
# Set to 1 to stop the entrypoint from starting `kyoube ensure-plugins --watch`
# (plugins are then only installed when you run `kyoube setup` / `kyoube
# ensure-plugins` yourself). Unset by default; any value other than 1 enables it.
KYOUBE_BOOTSTRAP_DISABLED=

# ---- Optional: headless provider keys for the agent harnesses ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ---- 0.1.x installs ----
# PAPERCLIP_PUBLIC_URL, PAPERCLIP_DEPLOYMENT_EXPOSURE and PAPERCLIP_VERSION are
# still honoured this release; `bash scripts/migrate-from-0.1.sh` renames them.
