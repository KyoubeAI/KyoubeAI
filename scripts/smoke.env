BETTER_AUTH_SECRET=smoke-only-secret-please-do-not-reuse-0123456789
POSTGRES_PASSWORD=smoke-postgres
KYOUBE_DB_PASSWORD=smoke-kyoube
KYOUBE_PUBLIC_URL=http://localhost:3199
KYOUBE_PORT=3199
KYOUBE_DEPLOYMENT_EXPOSURE=private
KYOUBE_CORE_VERSION=2026.1012.0
KYOUBE_VERSION=smoke
# The core rewrites a loopback KYOUBE_PUBLIC_URL's port to the container's
# internal PORT (3100, hardcoded in docker-compose.yml), so on this alternate
# KYOUBE_PORT the derived Better Auth trusted origin would still be :3100 and
# reject sign-up/claim requests whose Origin is :3199. Add the real origin back
# in verbatim (see docker-compose.yml's BETTER_AUTH_TRUSTED_ORIGINS comment).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3199
